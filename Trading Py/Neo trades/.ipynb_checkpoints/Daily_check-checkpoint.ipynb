    "import sqlite3\n",
    "import os\n",
    "\n",
    "# Path to IPython's history database\n",
    "db_path = os.path.expanduser('~/.ipython/profile_default/history.sqlite')\n",
    "\n",
    "if os.path.exists(db_path):\n",
    "    con = sqlite3.connect(db_path)\n",
    "    cursor = con.cursor()\n",
    "    \n",
    "    # Search for any executed line containing your missing file's name\n",
    "    search_term = '%dld_h4%'\n",
    "    cursor.execute(\"SELECT session, line, source FROM history WHERE source LIKE ?\", (search_term,))\n",
    "    \n",
    "    rows = cursor.fetchall()\n",
    "    \n",
